# OpsLens Environment Variables (Local Defaults)
# Reference: CODEBASE_MAP.md §11

# Stage (local | staging | prod)
STAGE=local

# DynamoDB single table
TABLE_NAME=opslens-local

# S3 media bucket
MEDIA_BUCKET=opslens-media-local

# EventBridge custom bus
EVENT_BUS_NAME=opslens-events-local

# SNS notification topic
NOTIFICATION_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:opslens-notifications-local

# LocalStack endpoint (for local development)
LOCALSTACK_ENDPOINT=http://localhost:4566
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1

# LLM provider (mock | bedrock) - defaults to mock on purpose to protect AWS credit budget
LLM_PROVIDER=mock

# AWS Bedrock settings (required when LLM_PROVIDER=bedrock)
BEDROCK_REGION=us-east-1
BEDROCK_TEXT_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# Embeddings dimensions (keep at 256)
EMBED_DIMENSIONS=256

# Cosine similarity thresholds
DUPLICATE_THRESHOLD=0.93
RELATED_THRESHOLD=0.86

# Demo mode (enables reset and seed endpoints)
DEMO_MODE=true

# Token budget per tenant per day
DAILY_TOKEN_BUDGET=200000

# Logging level (debug | info | warn | error)
LOG_LEVEL=debug
